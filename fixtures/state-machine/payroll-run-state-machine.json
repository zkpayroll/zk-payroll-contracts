    {
      "from": "confirming",
      "to": "failed",
      "initiator": "contract_or_reconciliation_operator",
      "user_visible": true,
      "reason": "Confirmation failed before a terminal success."
    },
    {
      "from": "confirming",
      "to": "reconciliation_required",
      "initiator": "contract_or_reconciliation_operator",
      "user_visible": true,
      "reason": "Execution happened, but reconciliation must be completed."
    },
    {
      "from": "failed",
